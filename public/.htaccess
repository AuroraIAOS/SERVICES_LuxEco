# BEGIN LUX APP (gerenciado pelo deploy: não editar entre os marcadores)
# HTTPS antes de qualquer outra regra. Sem fallback de SPA: o roteamento é HashRouter.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
<IfModule mod_headers.c>
# HSTS curto na primeira aplicação (subir para 1 ano depois de uma semana estável); só este host
Header always set Strict-Transport-Security "max-age=86400"
<FilesMatch "^index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#/assets/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
<If "%{REQUEST_URI} =~ m#/api/#">
Header set Cache-Control "no-store"
</If>
</IfModule>
# END LUX APP
